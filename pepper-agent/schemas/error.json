{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erictran308/pepper/blob/pepper/pepper-agent/schemas/error.json",
  "title": "pepper-agent error",
  "description": "What a command writes on stderr when it fails, as one line, with a non-zero exit (2 for BAD_ARGS). Do what the hint says.",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message", "hint"],
      "properties": {
        "code": {
          "enum": [
            "NO_VIEWER", "NO_SOURCE", "NOT_PLAYABLE", "LIMIT_REACHED", "MISSING_DEP", "UNSUPPORTED",
            "PERMISSION_NEEDED", "ORIGIN_BLOCKED", "NOT_OWNER", "INVALID_PROJECT", "TIMEOUT", "BAD_TIME",
            "BAD_ARGS", "BAD_REQUEST", "NOT_FOUND", "NOT_IN_PEPPER", "LOAD_FAILED", "SANDBOXED", "TOO_LONG",
            "FAILED"
          ]
        },
        "message": {"type": "string", "description": "What happened."},
        "hint": {"type": "string", "description": "What to do next."},
        "problems": {
          "type": "array",
          "description": "INVALID_PROJECT: every problem found.",
          "items": {
            "type": "object",
            "required": ["at", "problem"],
            "properties": {
              "at": {"type": "string", "description": "Where: clips[1].out, output.width; empty for the whole file."},
              "problem": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
